{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wiring",
  "version": "0.5.1",
  "identifier": "dev.wiring.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wiring",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 34 },
        "backgroundColor": "#1c1624"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzM0NCREIxNTA5QkY5RUUKUldUdStadFFzYjA4dzRQQ2czWS9WVWJBTmFjQXg0UHRFRG5jemk1Nng5NHc2UHFDY2oydVdJMUEK",
      "endpoints": ["https://github.com/skensell201/wiring/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright (c) 2026 skensel. MIT License.",
    "license": "MIT",
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
